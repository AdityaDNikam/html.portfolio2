<%- include('partials/header') %>

    <!-- Background Elements -->
    <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
        <div
            class="absolute top-[10%] left-[5%] w-96 h-96 bg-teal-600/20 rounded-full mix-blend-screen filter blur-[100px] animate-blob space-y-4">
        </div>
        <div
            class="absolute top-[30%] right-[10%] w-96 h-96 bg-blue-600/20 rounded-full mix-blend-screen filter blur-[100px] animate-blob animation-delay-2000">
        </div>
        <div
            class="absolute bottom-[20%] left-[20%] w-[500px] h-[500px] bg-purple-600/10 rounded-full mix-blend-screen filter blur-[120px] animate-blob animation-delay-4000">
        </div>
    </div>

    <main>
        <!-- HERO SECTION -->
        <section id="hero" class="relative min-h-screen flex items-center justify-center pt-20 px-4 sm:px-6 lg:px-8">
            <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

                <!-- Text Content -->
                <div class="order-2 lg:order-1 text-center lg:text-left slide-in-bottom">
                    <div
                        class="inline-block px-4 py-2 rounded-full border border-teal-500/30 bg-teal-500/10 text-teal-400 font-medium text-sm mb-6 shadow-[0_0_10px_rgba(20,184,166,0.1)]">
                        Available for Work
                    </div>
                    <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6">
                        Hi, I'm <br class="hidden lg:block" />
                        <span
                            class="bg-clip-text text-transparent bg-gradient-to-r from-teal-400 via-blue-500 to-purple-500">Aditya
                            P. Nikam</span>
                    </h1>
                    <div class="h-12 mb-6">
                        <p class="text-xl md:text-2xl text-gray-400 font-light" id="typewriter-text"></p>
                    </div>
                    <p class="text-gray-400 max-w-xl mx-auto lg:mx-0 mb-10 leading-relaxed text-lg">
                        I build high-performance, dynamic, and beautiful web applications. From intelligent backends to
                        stunning user interfaces, I bring ideas to life.
                    </p>

                    <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                        <a href="#projects"
                            class="bg-teal-500 hover:bg-teal-400 text-gray-950 px-8 py-3.5 rounded-full font-bold transition-all duration-300 transform hover:-translate-y-1 shadow-[0_0_20px_rgba(20,184,166,0.3)] hover:shadow-[0_0_30px_rgba(20,184,166,0.5)]">
                            View My Work
                        </a>
                        <a href="/resume%20Data+Dev.pdf" target="_blank"
                            class="border border-gray-600 hover:border-teal-500 hover:text-teal-400 bg-gray-900/50 backdrop-blur-sm px-8 py-3.5 rounded-full font-bold transition-all duration-300 transform hover:-translate-y-1">
                            Download Resume
                        </a>
                    </div>
                </div>

                <!-- Image Content -->
                <div class="order-1 lg:order-2 flex justify-center lg:justify-end fade-in">
                    <div class="relative w-64 h-64 sm:w-80 sm:h-80 lg:w-96 lg:h-96">
                        <!-- Glow effect behind image -->
                        <!-- <div
                            class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-gray-950 to-transparent z-0 h-1/3">
                        </div> -->
                        <div
                            class="absolute inset-0 bg-gradient-to-tr from-teal-500 to-blue-500 rounded-full blur-[40px] opacity-40 animate-pulse">
                        </div>

                        <div
                            class="relative z-0 h-full w-full rounded-full border-4 border-gray-800 overflow-hidden bg-gray-900 shadow-2xl ring-4 ring-teal-500/20">
                            <!-- We will hook up the image path to your actual image in public folder later -->
                            <img src="/images/heroimg.png" alt="Aditya Nikam"
                                class="object-cover w-full h-full scale-110 hover:scale-100 transition-transform duration-700"
                                id="hero-img">
                        </div>
                    </div>
                </div>

            </div>

            <!-- Scroll indicator -->
            <div
                class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce flex flex-col items-center text-gray-500">
                <span class="text-xs tracking-widest uppercase mb-2">Scroll</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
            </div>
        </section>

        <!-- SKILLS SECTION -->
        <section id="skills" class="py-24 bg-gray-900/30 border-y border-gray-800/50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16 fade-up">
                    <h2 class="text-teal-500 font-semibold tracking-wider uppercase text-sm mb-2">My Arsenal</h2>
                    <h3 class="text-3xl md:text-5xl font-bold tracking-tight">Technical <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-blue-500">Skills</span>
                    </h3>
                    <div class="mt-4 w-24 h-1 bg-gradient-to-r from-teal-500 to-blue-500 mx-auto rounded-full"></div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6 fade-up">
                    <!-- Skill Card Template -->
                    <% const skills=[ {name: 'MongoDB' , iconClass: 'devicon-mongodb-plain colored' ,
                        color: 'group-hover:border-green-500/50' }, {name: 'Express.js' ,
                        iconClass: 'devicon-express-original' , color: 'group-hover:border-gray-300/50' },
                        {name: 'React.js' , iconClass: 'devicon-react-original colored' ,
                        color: 'group-hover:border-blue-400/50' }, {name: 'Node.js' ,
                        iconClass: 'devicon-nodejs-plain colored' , color: 'group-hover:border-green-600/50' },
                        {name: 'Tailwind CSS' , iconClass: 'devicon-tailwindcss-original colored' ,
                        color: 'group-hover:border-cyan-400/50' }, {name: 'JavaScript' ,
                        iconClass: 'devicon-javascript-plain colored' , color: 'group-hover:border-yellow-400/50' } ] %>

                        <% skills.forEach(skill=> { %>
                            <div
                                class="group bg-gray-900 border border-gray-800 <%= skill.color %> rounded-2xl p-6 text-center transition-all duration-300 hover:bg-gray-800 hover:-translate-y-2 hover:shadow-[0_10px_20px_rgba(20,184,166,0.1)]">
                                <div
                                    class="w-16 h-16 mx-auto bg-gray-950 rounded-xl flex items-center justify-center mb-4 border border-gray-800 transition-colors">
                                    <i class="<%= skill.iconClass %> text-4xl text-gray-200"></i>
                                </div>
                                <h4 class="font-semibold text-gray-200">
                                    <%= skill.name %>
                                </h4>
                            </div>
                            <% }) %>
                </div>
            </div>
        </section>

        <!-- PROJECTS SECTION -->
        <section id="projects" class="py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16 fade-up">
                    <h2 class="text-teal-500 font-semibold tracking-wider uppercase text-sm mb-2">Portfolio</h2>
                    <h3 class="text-3xl md:text-5xl font-bold tracking-tight">Featured <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-blue-500">Projects</span>
                    </h3>
                    <p class="mt-4 text-gray-400 max-w-2xl mx-auto">Here are some of my best works that showcase my
                        ability to build robust, scalable, and visually stunning applications.</p>
                    <div class="mt-6 w-24 h-1 bg-gradient-to-r from-teal-500 to-blue-500 mx-auto rounded-full"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <% projects.forEach((project, index)=> { %>
                        <div class="glass-card rounded-2xl overflow-hidden group fade-up">

                            <%# Gradient Banner %>
                                <div class="relative h-48 overflow-hidden">
                                    <div
                                        class="absolute inset-0 bg-gradient-to-br <%= project.gradient %> opacity-90 group-hover:opacity-100 transition-opacity duration-500">
                                    </div>
                                    <div
                                        class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(255,255,255,0.05)_0%,_transparent_70%)]">
                                    </div>
                                    <%# Decorative circles %>
                                        <div
                                            class="absolute -bottom-6 -right-6 w-32 h-32 rounded-full bg-white/5 border border-white/10">
                                        </div>
                                        <div
                                            class="absolute -top-4 -left-4 w-20 h-20 rounded-full bg-white/5 border border-white/10">
                                        </div>
                                        <div class="relative z-10 h-full w-full">
                                            <img src="<%- project.image %>" alt="<%- project.name %>"
                                                class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-110 transition-all duration-700">
                                        </div>
                                </div>

                                <%# Card Body %>
                                    <div
                                        class="p-6 bg-gray-900 border break-words border-gray-800 group-hover:border-teal-500/30 transition-colors duration-300">
                                        <h4 class="text-xl font-bold text-gray-100 mb-2">
                                            <%= project.name %>
                                        </h4>
                                        <p class="text-gray-400 text-sm mb-4 leading-relaxed">
                                            <%= project.description %>
                                        </p>

                                        <div class="flex flex-wrap gap-2 mb-6">
                                            <% project.tags.forEach(tag=> { %>
                                                <span
                                                    class="px-3 py-1 text-xs font-medium <%= tag.color %> rounded-full">
                                                    <%= tag.label %>
                                                </span>
                                                <% }) %>
                                        </div>

                                        <div class="flex items-center gap-4">
                                            <% if (project.liveUrl) { %>
                                                <a href="<%= project.liveUrl %>" target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="text-sm font-semibold text-white bg-teal-600 hover:bg-teal-500 px-4 py-2 rounded-lg transition-colors inline-flex items-center gap-1.5">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor"
                                                        viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                                    </svg>
                                                    Live Demo
                                                </a>
                                                <% } %>
                                                    <a href="<%= project.githubUrl %>" target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="text-sm font-semibold text-gray-400 hover:text-white transition-colors inline-flex items-center gap-1.5">
                                                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                                            <path
                                                                d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.929.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
                                                        </svg>
                                                        GitHub
                                                    </a>
                                        </div>
                                    </div>
                        </div>
                        <% }) %>
                </div>
            </div>
        </section>

        <!-- CONTACT SECTION -->
        <section id="contact" class="py-24 bg-gray-900/30 border-y border-gray-800/50 relative">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
                <h2 class="text-teal-500 font-semibold tracking-wider uppercase text-sm mb-2">What's Next?</h2>
                <h3 class="text-3xl md:text-5xl font-bold tracking-tight mb-6">Get In Touch</h3>
                <p class="text-gray-400 max-w-xl mx-auto mb-10 text-lg">
                    I'm currently looking for new opportunities, and my inbox is always open. Whether you have a
                    question or just want to say hi, I'll try my best to get back to you!
                </p>
                <a href="mailto:aditya.prakash.nikam.2004@gmail.com"
                    class="inline-block bg-transparent border-2 border-teal-500 text-teal-500 hover:bg-teal-500 hover:text-gray-950 px-10 py-4 rounded-full font-bold text-lg transition-all duration-300 shadow-[0_0_15px_rgba(20,184,166,0.1)] hover:shadow-[0_0_30px_rgba(20,184,166,0.4)] transform hover:-translate-y-1">
                    Say Hello
                </a>

                <div class="mt-16 text-gray-400">
                    <p>Contact no.: <span class="text-gray-200">7083887753</span></p>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>